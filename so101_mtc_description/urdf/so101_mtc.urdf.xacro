<?xml version="1.0"?>
<!--
  The SO-101 of so101_mtc: the official URDF so101_new_calib (TheRobotStudio SO-ARM100, Apache-2.0), unmodified but
  for its mesh paths (see CMakeLists.txt), with our frames: world, the table, the TCP, the fixed camera and the
  ros2_control tag for MuJoCo (ADR 0002, ADR 0003). mujoco/scene.xml.xacro repeats the table and the camera for MuJoCo;
  test/test_description.py checks that the two agree.
-->
<robot name="so101_mtc" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="mujoco_model" default="$(find so101_mtc_description)/mujoco/scene.xml"/>
  <xacro:arg name="headless" default="false"/>
  <xacro:arg name="sim_speed_factor" default="-1"/>  <!-- < 0: real time -->

  <xacro:include filename="$(find so101_mtc_description)/upstream/SO101/so101_new_calib.urdf"/>

  <!-- world: the table top, with base_link at its origin -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- Table: a box with its top at z = 0, so that MoveIt plans around it; it covers the camera's view -->
  <xacro:property name="table_size" value="0.8 0.9 0.04"/>
  <xacro:property name="table_centre" value="0.2 0 -0.02"/>
  <link name="table">
    <visual>
      <origin xyz="${table_centre}"/>
      <geometry><box size="${table_size}"/></geometry>
      <material name="table"><color rgba="0.72 0.72 0.7 1"/></material>
    </visual>
    <collision>
      <origin xyz="${table_centre}"/>
      <geometry><box size="${table_size}"/></geometry>
    </collision>
  </link>
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table"/>
  </joint>

  <!-- TCP: the centre of a grasped 25 mm block between the jaws, measured in MuJoCo (ADR 0003). Its axes are those
    of the upstream gripper_frame_link: z out of the jaws, along the approach; y as in gripper_link -->
  <link name="tcp"/>
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_link"/>
    <child link="tcp"/>
    <origin xyz="0.0039 -0.0002 -0.0958" rpy="0 ${pi} 0"/>
  </joint>

  <!-- Fixed camera, straight down over the block area (the camera "camera" of mujoco/scene.xml).
    camera_link (REP 103): x along the view, y to the image's left, z to its top.
    camera_optical_frame: z along the view, x to the image's right, y down; images and camera_info use it. -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="world"/>
    <child link="camera_link"/>
    <origin xyz="0.22 0 0.55" rpy="0 ${pi / 2} 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
  </joint>

  <!-- ros2_control: MuJoCo's hardware interface simulates mujoco/scene.xml and commands its position actuators.
    Pattern: mujoco_ros2_control_demos test_robot.urdf (Apache-2.0). -->
  <xacro:macro name="position_joint" params="name initial">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(arg mujoco_model)</param>
      <param name="headless">$(arg headless)</param>
      <param name="sim_speed_factor">$(arg sim_speed_factor)</param>
    </hardware>
    <!-- The home pose: the arm folded, the gripper up and closed, out of the camera's view of the block area -->
    <xacro:position_joint name="shoulder_pan" initial="0.0"/>
    <xacro:position_joint name="shoulder_lift" initial="-1.2"/>
    <xacro:position_joint name="elbow_flex" initial="0.6"/>
    <xacro:position_joint name="wrist_flex" initial="-1.0"/>
    <xacro:position_joint name="wrist_roll" initial="0.0"/>
    <xacro:position_joint name="gripper" initial="0.0"/>
  </ros2_control>
</robot>
