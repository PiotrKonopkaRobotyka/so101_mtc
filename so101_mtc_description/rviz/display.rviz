Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.1
      Plane Cell Count: 10
      Offset:
        X: 0.2
        Y: 0
        Z: 0.001
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Alpha: 1
      Description Topic:
        Value: /robot_description
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: TCP
      Reference Frame: tcp
      Length: 0.05
      Radius: 0.003
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: Camera
      Reference Frame: camera_optical_frame
      Length: 0.08
      Radius: 0.005
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Marker Scale: 0.2
      Show Arrows: false
      Value: false
  Global Options:
    Fixed Frame: world
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.4
      Focal Point:
        X: 0.15
        Y: 0
        Z: 0.15
      Name: Current View
      Pitch: 0.45
      Value: Orbit (rviz)
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1200
