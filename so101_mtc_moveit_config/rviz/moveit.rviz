Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
  - Class: moveit_task_constructor/Motion Planning Tasks
    Name: Motion Planning Tasks
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.1
      Plane Cell Count: 10
      Offset:
        X: 0.2
        Y: 0
        Z: 0.001
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Move Group Namespace: ""
      Planning Request:
        Planning Group: arm
        Interactive Marker Size: 0.15
        Query Goal State: true
        Query Start State: false
      Planned Path:
        Loop Animation: false
        State Display Time: 0.05 s
        Trajectory Topic: /display_planned_path
      Planning Scene Topic: /monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 1
      Scene Robot:
        Robot Alpha: 1
      Value: true
    - Class: moveit_task_constructor/Motion Planning Tasks
      Name: Motion Planning Tasks
      Robot Description: robot_description
      Task Solution Topic: /solution
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera
      Topic:
        Value: /camera/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
  Global Options:
    Fixed Frame: world
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.2
      Focal Point:
        X: 0.15
        Y: 0
        Z: 0.1
      Name: Current View
      Pitch: 0.5
      Target Frame: world
      Yaw: 0.8
# Where the panels dock: MotionPlanning, Displays and the MTC panel on the left, the camera image on the right.
# Qt's QMainWindow::saveState() in hex, made with PyQt5: dock widgets named like the panels, laid out in a
# 1500 x 1000 window. Saving the config from RViz (File > Save Config) rewrites it after a manual change.
Window Geometry:
  Camera:
    collapsed: false
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  Motion Planning Tasks:
    collapsed: false
  MotionPlanning:
    collapsed: false
  QMainWindow State: 
  Width: 1500
